# ResumeLens AI - Environment Configuration Template
# Copy this file to .env and adjust values as needed.

# Database: SQLite (default zero-config mode, no install needed)
DATABASE_URL=sqlite+aiosqlite:///./resumematcher.db
DATABASE_URL_SYNC=sqlite:///./resumematcher.db

# Optional: PostgreSQL with pgvector (for production / Docker)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/resume_matcher
# DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/resume_matcher

# JWT Secret Key
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# Google Gemini API Key (Enables live AI strengths, weaknesses, and skill roadmap)
# Leave blank to use local fallback recommendations
GEMINI_API_KEY=

# Application Settings
DEBUG=false
APP_NAME=ResumeLens AI
MAX_UPLOAD_SIZE_MB=10
